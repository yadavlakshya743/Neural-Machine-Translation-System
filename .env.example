# ==========================================
# Neural Machine Translation System - Environment Configuration
# Copy to .env and adjust. Never commit .env.
# ==========================================

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Trained checkpoints (one per direction). Tokenizers saved next to each checkpoint are used.
MODEL_CHECKPOINT_PATH=models/transformer_small_en-hi/best.pt
MODEL_CHECKPOINT_PATH_HI_EN=models/transformer_small_hi-en/best.pt
# 'cpu' is safest while a training job is using the GPU; 'cuda' for faster inference otherwise.
DEVICE=cpu

# Decoding defaults
DEFAULT_DECODING_STRATEGY=beam_search
DEFAULT_BEAM_SIZE=4
DEFAULT_LENGTH_PENALTY=0.6
MAX_GEN_LENGTH=128

# Security: generate your own key, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Users + translation history (SQLite file)
DATABASE_URL=sqlite:///./translation_history.db
