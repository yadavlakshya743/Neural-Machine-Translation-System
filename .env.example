# ==========================================
# Neural Machine Translation System - Environment Configuration
# ==========================================

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
APP_ENV=development

# ML Model Paths & Checkpoint
MODEL_CHECKPOINT_PATH=models/best_transformer_en_hi.pt
TOKENIZER_EN_PATH=ml/tokenization/spm_en.model
TOKENIZER_HI_PATH=ml/tokenization/spm_hi.model
DEVICE=cuda  # or 'cpu'

# Inference & Decoding Defaults
DEFAULT_DECODING_STRATEGY=beam_search # 'greedy' or 'beam_search'
BEAM_SIZE=4
MAX_GEN_LENGTH=128
LENGTH_PENALTY=0.6

# Security & Sessions
SECRET_KEY=supersecretjwtkey_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (Translation History & Experiments)
DATABASE_URL=sqlite:///./translation_history.db
